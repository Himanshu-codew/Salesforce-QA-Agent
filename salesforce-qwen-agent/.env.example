# ──────────────────────────────────────────────────────────────
# Salesforce QA Agent - Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` (it is gitignored). Secrets stay local.
# ──────────────────────────────────────────────────────────────

# --- LLM (Qwen) ---
# OpenAI-compatible base URL. Ollama local default, or a hosted endpoint.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen2.5-coder:14b
QWEN_API_KEY=ollama
LLM_TIMEOUT=600.0

# --- Salesforce (connected app / REST) ---
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login
SALESFORCE_AUTH_HOST=login
SALESFORCE_OAUTH_SCOPE=
SALESFORCE_REDIRECT_URI=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_REFRESH_TOKEN=

# --- Salesforce MCP (Hosted MCP) ---
# When "true", list_tools()/call_tool() MUST go through MCP and REST fallback
# MUST NOT silently hide MCP failures.
SALESFORCE_MCP_URL=
SALESFORCE_MCP_REQUIRED=false

# --- Semantic RAG ---
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=6
RAG_MIN_SCORE=
ENABLE_RAG_TOOLS=true

# --- Orchestrator / agent runtime ---
MAX_TOOL_CALLS_PER_TURN=10
MAX_CONVERSATION_HISTORY=20

# --- App server ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Encrypted token vault (never commit real KEK / token files) ---
SF_TOKEN_KEK=
SF_TOKEN_KEK_FILE=
SF_TOKEN_STORE_PATH=
